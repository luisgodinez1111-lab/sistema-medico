{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ]
}