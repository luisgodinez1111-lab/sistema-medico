{
  "name": "medical-os",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "traceability:check": "tsx packages/clinical-safety/src/validate-registry.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:safety": "vitest run tests/traceability",
    "release:check": "tsx packages/clinical-safety/src/release-admission.ts",
    "verify": "pnpm typecheck && pnpm traceability:check && pnpm test:safety && pnpm release:check",
    "test:all": "vitest run tests",
    "verify:v5": "node release/v5/self-check.mjs",
    "db:check": "node release/v5/sql-check.mjs",
    "verify:v12": "node release/v12/self-check.mjs && node release/v12/vertical-runtime-conformance.mjs && node release/v12/sql-static-check.mjs",
    "test:v12": "vitest run tests/v12",
    "build:web": "next build apps/web",
    "verify:v15": "node release/v15/self-check.mjs && node release/v15/conformance.mjs && node release/v15/sql-check.mjs",
    "runtime:bootstrap": "bash scripts/bootstrap.sh",
    "verify:v16": "node release/v16/self-check.mjs && node release/v16/deep-bug-audit.mjs && node release/v16/conformance.mjs && node release/v16/sql-check.mjs",
    "test:v16": "vitest run tests/v16",
    "verify:v17": "node release/v17/self-check.mjs && node release/v17/migration-integrity-check.mjs && node release/v17/deep-bug-audit.mjs && node release/v17/schema-compiler.mjs && node release/v17/conformance.mjs",
    "test:v17": "vitest run tests/v17"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4",
    "jsdom": "^25",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.26.0",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.2.12",
    "next": "^15.5.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}