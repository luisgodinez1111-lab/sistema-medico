{
  "name": "medical-os",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "traceability:check": "tsx packages/clinical-safety/src/validate-registry.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:safety": "vitest run tests/traceability",
    "release:check": "tsx packages/clinical-safety/src/release-admission.ts",
    "verify": "pnpm typecheck && pnpm typecheck:web && pnpm traceability:check && pnpm test:safety && pnpm release:check",
    "test:all": "vitest run tests",
    "db:check": "tsx scripts/db/check.mts",
    "outbox:purge": "tsx scripts/ops/outbox-purge.mts",
    "audit:verify": "tsx scripts/ops/verify-audit-chain.mts",
    "db:migrate": "tsx scripts/db/migrate.mts",
    "db:manifest": "tsx scripts/db/manifest.mts",
    "build:web": "next build apps/web",
    "runtime:bootstrap": "bash scripts/bootstrap.sh",
    "typecheck:web": "tsc --noEmit --incremental false -p apps/web/tsconfig.json",
    "openapi:generate": "tsx scripts/ops/openapi.mts",
    "openapi:check": "tsx scripts/ops/api-body-registry.mts --check && tsx scripts/ops/openapi.mts --check",
    "phi:retention": "tsx scripts/ops/phi-retention.mts",
    "openapi:registry": "tsx scripts/ops/api-body-registry.mts",
    "capability:check": "tsx packages/clinical-safety/src/capability-admission.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4",
    "jsdom": "^25",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.26.0",
    "@vercel/blob": "^2.8.0",
    "jose": "^6.2.12",
    "next": "^15.5.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
