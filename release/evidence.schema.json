{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifact",
    "authority",
    "tests",
    "reviewer",
    "status"
  ],
  "properties": {
    "artifact": {
      "type": "string"
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAIL"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}