NODE_ENV=development
DATABASE_URL=postgres://medical_os_runtime:change_me@localhost:5432/medical_os
TEST_DATABASE_URL=postgres://medical_os_runtime:change_me@localhost:5432/medical_os
AUTH_MODE=development
OTEL_SERVICE_NAME=medical-os
# EPIC B — secreto HMAC para firmar/verificar la sesión clínica (fail-closed si ausente).
SESSION_SIGNING_SECRET=change_me_high_entropy_secret
# EPIC E — secreto del "IdP de desarrollo" para el verificador de identidad de pruebas.
# SOLO desarrollo: en producción el verificador dev está deshabilitado por código.
DEV_IDENTITY_SECRET=change_me_dev_idp_secret
# EPIC L (hardening) — opt-in explícito del verificador dev. PRODUCCIÓN NUNCA debe ponerlo.
ALLOW_DEV_IDENTITY=
# EPIC F — verificador OIDC real (Auth0/Clerk/SSO). Si issuer+audience están, tiene prioridad
# y funciona también en producción (la desbloquea). JWKS se deduce del issuer si no se da.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
# Nombres de claims para tenant/roles/scopes (defaults: tenant_id, roles, scope).
OIDC_TENANT_CLAIM=
OIDC_ROLES_CLAIM=
OIDC_SCOPES_CLAIM=
# EPIC J — frontend de login (públicas, van al navegador). Client ID de la SPA de Auth0.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=medical-os
