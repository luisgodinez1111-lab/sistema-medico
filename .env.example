# Medical OS — variables de entorno de ejemplo.
# Copiar a .env.local (NUNCA commitear .env*). Ver §16, §33.

# --- Base de datos (Neon Postgres) ---
# Conexión pooled para la app (runtime)
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/medical_os?sslmode=require"
# Conexión directa para migraciones (sin pooler)
DIRECT_DATABASE_URL="postgresql://user:password@host.region.neon.tech/medical_os?sslmode=require"

# --- App ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Identidad demo (PROVISIONAL, hasta el IdP de NIVEL 2) ---
# Principal resuelto server-side mientras no hay sesión real. Tienen default en
# código (velum-demo / demo@velum.local); sobrescribir sólo si cambia el seed.
# DEMO_TENANT_SLUG="velum-demo"
# DEMO_USER_EMAIL="demo@velum.local"

# --- Auth (IdP con MFA/WebAuthn — §3) ---
# AUTH_SECRET=""
# AUTH_ISSUER=""

# --- Object storage privado (§10) ---
# BLOB_READ_WRITE_TOKEN=""
