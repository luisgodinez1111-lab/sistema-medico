# Medical OS — variables de entorno. Solo las que el código LEE (auditoría P-16: `.env.example` documentaba nombres
# muertos y el código leía otros sin documentar). Ningún valor real aquí; en local se copia a `.env.local` (ignorado).

# --- Base de datos ---------------------------------------------------------------------------------------------
# Conexión de la aplicación: usuario conector con GRANT del rol `medical_os_runtime` (SET ROLE en cada transacción).
DATABASE_URL=postgres://medical_os_migrator:change_me@localhost:5432/medical_os
# Base DESECHABLE para las pruebas en vivo (scripts/ci/live-smoke.mts). Obligatoria para ellas; se niegan a usar la de la app.
TEST_DATABASE_URL=postgres://medical_os_migrator:change_me@localhost:5432/medical_os_test

# --- Sesión e identidad ----------------------------------------------------------------------------------------
# Secreto HMAC de la sesión clínica (cookie medos_session). Sin él la API falla cerrada.
SESSION_SIGNING_SECRET=change_me_high_entropy_secret
# Verificador OIDC real (Auth0/SSO). Con issuer + audience tiene prioridad y es el único válido en producción.
# JWKS se deduce del issuer si no se da. Claims: tenant_id, roles, scope por defecto.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_TENANT_CLAIM=
OIDC_ROLES_CLAIM=
OIDC_SCOPES_CLAIM=
# Login SPA (públicas, van al navegador). El dominio entra en la CSP en tiempo de build.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=medical-os
# Verificador de identidad de DESARROLLO (deshabilitado por código en producción). Producción NUNCA define ALLOW_DEV_IDENTITY.
AUTH_MODE=development
ALLOW_DEV_IDENTITY=
DEV_IDENTITY_SECRET=change_me_dev_idp_secret

# --- Almacenamiento privado ------------------------------------------------------------------------------------
# Vercel Blob privado: firma y sello del médico, adjuntos de documentos.
BLOB_READ_WRITE_TOKEN=

# --- Funcionalidad ---------------------------------------------------------------------------------------------
# Verticales hospitalarias (transfusión, cirugía, diálisis, triage, admisión, muestras, heridas). APAGADAS por defecto:
# con cualquier valor distinto del literal "true" sus rutas /api/v1/* responden 404 y la UI no muestra sus paneles.
# No encender en producción sin sus datos de seguridad (ABO/Rh, lista de verificación quirúrgica) y revisión clínica (L-10/L-11).
ENABLE_HOSPITAL_VERTICALS=false
# Copiloto de IA: apagado (R6 en pausa). AI_COPILOT_SHADOW=true evalúa en sombra sin efecto clínico.
AI_COPILOT_ENABLED=false
AI_COPILOT_SHADOW=false
# OBSERVABILITY_EMIT=1 escribe eventos SLI en stdout (no existe exportador).
OBSERVABILITY_EMIT=

# --- Guardas de scripts destructivos (nunca en producción) -----------------------------------------------------
# CI_DB_BOOTSTRAP_ALLOW=1 permite scripts/ci/bootstrap-db.mts (roles + migraciones) SOLO contra una base desechable.
CI_DB_BOOTSTRAP_ALLOW=
# LIVE_PROOF_ALLOW_SHARED_DB=1 deja que las pruebas en vivo usen una base cuyo host coincide con DATABASE_URL (no recomendado).
LIVE_PROOF_ALLOW_SHARED_DB=
# RESTORE_DATABASE_URL: destino del simulacro de restauración (scripts/v22/restore-drill.mts); rehúsa si es la base de la app.
RESTORE_DATABASE_URL=

# NODE_ENV y VERCEL_ENV los pone la plataforma.
