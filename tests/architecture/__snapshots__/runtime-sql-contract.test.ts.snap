   where ($5='' or lower(p.name) like $6 or lower(p.name) like $7 or lower(coalesce(p.curp,'')) like $8)
     and ($9::text is null or (p.name, p.aggregate_id::text) > ($10::text, $11::text))
   order by p.name, p.aggregate_id
   limit $12",
