     (select p.payload->>'name' from clinical_events p where p.tenant_id=$3 and p.aggregate_type='Patient' and p.payload->>'kind'='REGISTERED' and p.aggregate_id=(a.payload->>'patientId')::uuid limit 1) as patient_name
   from clinical_events a
   where a.tenant_id=$4 and a.aggregate_type='Appointment' and a.payload->>'kind'='SCHEDULED'
     and a.payload->>'startAt' >= $5 and a.payload->>'startAt' < $6
   order by a.payload->>'startAt' asc",
      },
